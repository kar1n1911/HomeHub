# Kubernetes reads distinct credentials from generated Secrets.
# Compose uses generated .secrets/* files; run scripts/create-db-secrets.py compose.
# To run ONE API manually, set its dedicated identity and password externally:
PGHOST=localhost
PGPORT=5432
PGDATABASE=homehub_task
PGUSER=homehub_task
PGSSLMODE=require
# PGPASSWORD or PGPASSWORD_FILE must be supplied securely. No shared fallback.
